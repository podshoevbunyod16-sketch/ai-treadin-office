# Copy to backend/.env and adjust. All variables are optional.
ATO_ENVIRONMENT=production

# Database (default: SQLite file in backend/data). PostgreSQL example:
# ATO_DATABASE_URL=postgresql+psycopg://user:pass@localhost:5432/ato   (pip install "psycopg[binary]")

# Secrets. If empty they are generated on first start and stored in backend/data with chmod 600.
# KEEP ATO_ENCRYPTION_KEY SAFE: without it the stored broker passwords cannot be decrypted.
# Generate:  python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
ATO_JWT_SECRET=
ATO_ENCRYPTION_KEY=

ATO_ACCESS_TOKEN_MINUTES=720
# Only needed when the frontend is served from another origin (dev server is proxied, no CORS needed)
# ATO_CORS_ORIGINS=["https://office.example.com"]

# Safety switch: trading on REAL accounts is refused unless this is true
ATO_ALLOW_REAL_TRADING=false

ATO_QUOTE_INTERVAL_MS=1000
ATO_ACCOUNT_INTERVAL_MS=2000
ATO_RECONNECT_INTERVAL_S=15
ATO_MT5_CALL_TIMEOUT_S=30
